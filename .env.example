# Salin ke .env.local lalu isi. JANGAN commit .env.local atau nilai asli.

# --- AI (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Supabase: bagian publik (boleh dipakai browser; ini BUKAN service role key) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: bagian server saja (API dan `npm run seed` / `npm run demo:users`) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Aplikasi ---
# URL produksi, dipakai untuk isi QR batch. Kosongkan untuk memakai host permintaan.
NEXT_PUBLIC_SITE_URL=
# "true" selama data masih tiruan (menampilkan banner DATA DEMO). Setel "false" HANYA bila memakai data nyata.
NEXT_PUBLIC_DEMO_MODE=true
# Hanya untuk `npm run demo:users` (opsional). Kosong = dibangkitkan acak.
DEMO_PASSWORD=
# JANGAN dipakai di produksi: membuka tulis-data tanpa login bila Supabase Auth belum dikonfigurasi.
# DEMO_OPEN_WRITE=false
